{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/normal-game",
      "destination": "/normal-game/index.html"
    },
    {
      "source": "/medium-game",
      "destination": "/medium-game/index.html"
    },
    {
      "source": "/hard-game",
      "destination": "/hard-game/index.html"
    },
    {
      "source": "/support",
      "destination": "/support/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
